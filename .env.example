# ==============================================================================
# Vision-Based Desktop Automation — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your API keys.
# ==============================================================================

# --- REQUIRED: Groq API Key (Primary backend - FREE) ---
# Get your free key at: https://console.groq.com → API Keys
# You can add multiple comma-separated keys for rate-limit rotation:
GROQ_API_KEY=your_groq_key_here,optional_second_key,optional_third_key

# --- REQUIRED: Gemini API Key (Last-resort fallback - FREE) ---
# Get your free key at: https://aistudio.google.com → Create API Key
GEMINI_API_KEY=your_gemini_key_here

# --- OPTIONAL: Backends ---
# Primary backend: "groq" (default), "sbg", or "gemini"
PLANNER_BACKEND=gemini
GROUNDER_BACKEND=gemini

# --- OPTIONAL: Model Names ---
GROQ_PLANNER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_GROUNDER_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_PLANNER_MODEL=gemini-3.5-flash-lite
GEMINI_GROUNDER_MODEL=gemini-3.5-flash-lite

# --- OPTIONAL: SBG API (only needed if PLANNER_BACKEND=sbg or GROUNDER_BACKEND=sbg) ---
SBG_BASE_URL=http://your-sbg-gateway/api/v1
SBG_API_KEY=your_sbg_key_here
SBG_PLANNER_MODEL=qwen.qwen3-vl-235b-a22b
SBG_GROUNDER_MODEL=qwen.qwen3-vl-235b-a22b

# --- OPTIONAL: Tuning ---
# Max times to retry grounding if icon not found
MAX_GROUNDING_RETRIES=3
# Max recursive search depth (ScreenSeekeR paper: depth 3 is optimal)
MAX_SEARCH_DEPTH=3
# Confidence threshold to accept a grounding result (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.60
# Number of candidate regions planner should propose (2-5 recommended)
NUM_CANDIDATES=3

# --- OPTIONAL: Output Directory ---
# Default: output/ within the repository root
# OUTPUT_DIR=C:\path\to\your\preferred\output-directory
